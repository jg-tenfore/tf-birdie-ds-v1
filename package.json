{
    "name": "tf-birdie-ds-v1",
    "version": "0.0.0",
    "engines": {
        "node": ">=22"
    },
    "private": true,
    "type": "module",
    "scripts": {
        "storybook": "storybook dev -p 6020",
        "build-storybook": "storybook build -o dist/storybook",
        "build-site": "node scripts/build-site.mjs",
        "build": "npm run build-storybook && npm run build-app && npm run build-site",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "generate:catalog": "node scripts/generate-catalog.mjs",
        "generate:customers": "node scripts/generate-customers.mjs",
        "dev:app": "vite",
        "build-app": "vite build",
        "smoke": "node scripts/smoke-test.mjs",
        "generate:food": "node scripts/generate-food-catalog.mjs",
        "smoke:serve": "node scripts/serve-dist.mjs",
        "smoke:ci": "npm run build && node scripts/serve-dist.mjs --smoke",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/roboto": "^5.2.8",
        "@fontsource/roboto-mono": "^5.2.8",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-router-dom": "^7.18.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@storybook/addon-a11y": "^10.5.5",
        "@storybook/addon-docs": "^10.5.5",
        "@storybook/addon-themes": "^10.5.5",
        "@storybook/react-vite": "^10.5.5",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.9.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-storybook": "^10.5.10",
        "globals": "^17.11.0",
        "playwright": "^1.62.0",
        "prettier": "^3.8.1",
        "remark-gfm": "^4.0.1",
        "storybook": "^10.5.5",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.1.5"
    }
}
